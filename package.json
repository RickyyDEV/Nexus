{
  "name": "nexus",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "imports": {
    "#components/*": "./src/style/components/*.tsx",
    "#lib/*": "./src/style/lib/*.ts",
    "#hooks/*": "./src/style/hooks/*.ts"
  },
  "scripts": {
    "dev:dashboard": "bun --env-file=.env --bun --cwd apps/dashboard --bun dev",
    "dev:api": "bun --env-file=.env --bun --cwd apps/backend --bun dev",
    "dev:bot": "cargo run --manifest-path apps/bot/Cargo.toml",
    "build:dashboard": "bun --env-file=.env --bun --cwd apps/dashboard --bun build",
    "start:dashboard": "bun --env-file=.env --bun --cwd apps/dashboard --bun preview",
    "start:api": "bun --env-file=.env --bun --cwd apps/backend --bun dev",
    "dev": "bun --env-file=.env --bun run --parallel dev:dashboard dev:api",
    "build": "bun --env-file=.env --bun run --parallel build:dashboard",
    "start": "bun --env-file=.env --bun run --parallel start:dashboard start:api",
    "migrate": "cd apps/backend && bunx --bun --env-file=../../.env prisma migrate dev"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  }
}
