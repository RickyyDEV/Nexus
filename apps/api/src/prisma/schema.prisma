// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
  serverMembers ServerMember[] @relation("ServerMembers")
  servers Server[] @relation("ServerOwner")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


model Server {
  id                 String    @id @default(uuid())
  discordGuildId     BigInt    @unique            // snowflake
  name               String
  iconHash           String?
  ownerUserId        String                       // quem instalou = Nexus owner
  ownerUser          User      @relation("ServerOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  installedAt       DateTime   @default(now())
  botPresent         Boolean   @default(true)     // false quando bot sai (config fica congelada)
  memberCount        Int       @default(0)        // cacheado pelo bot
  memberCountUpdatedAt DateTime?
  premium            Boolean   @default(false)    // GANCHO futuro — não usar ainda
  premiumUntil       DateTime?                    // GANCHO futuro
  premiumPlan        String?                      // GANCHO futuro
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  members            ServerMember[]
  config             ServerConfig?
  moduleConfigs      ModuleConfig[]
  automations        Automation[]
  auditLogs          AuditLog[]
  eventLogs          BotEventLog[]
  channelToggles     ChannelModuleToggle[]

  @@index([ownerUserId])
  @@map("server")
}

model ServerMember {
  id          String   @id @default(uuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ServerMembers", fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("admin")          // "owner" | "admin"
  invitedBy   String?
  invitedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
  @@map("server_member")
}

model ServerConfig {
  serverId      String   @id
  server        Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  prefix        String   @default("!")
  language      String   @default("pt-BR")
  timezone      String   @default("America/Sao_Paulo")
  updatedBy     String?
  updatedAt     DateTime @updatedAt

  @@map("server_config")
}

model ModuleConfig {
  id          String   @id @default(uuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  moduleType  String                              // "welcome" | "anti_link" | "moderation" | "auto_roles" | "tickets"
  enabled     Boolean  @default(false)
  config      Json     @default("{}")             // JSONB — formato versionado por moduleType
  schemaVersion Int    @default(1)                // p/ migrations de schema interno futuro
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@unique([serverId, moduleType])
  @@index([serverId])
  @@map("module_config")
}

model ChannelModuleToggle {
  id          String   @id @default(uuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channelId   String                              // snowflake como text (anti-link per-canal)
  moduleType  String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([serverId, channelId, moduleType])
  @@index([serverId])
  @@map("channel_module_toggle")
}

model Automation {
  id              String   @id @default(uuid())
  serverId        String
  server          Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean  @default(true)
  triggerType     String                              // "member_join" | "message_sent" | "link_detected" | "mention_mass" | "reaction_added"
  triggerConfig   Json     @default("{}")             // condição refinada
  actions         Json                                 // array de { type, config }
  executionCount  Int      @default(0)
  lastExecutedAt  DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([serverId])
  @@index([serverId, enabled])
  @@map("automation")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId      String?
  action       String                               // "module.enable", "automation.create", "config.update"
  entityType  String?
  entityId    String?
  before      Json?                                  // snapshot antes
  after       Json?                                  // snapshot depois
  createdAt   DateTime @default(now())

  @@index([serverId, createdAt])
  @@map("audit_log")
}

model BotEventLog {
  id          BigInt   @id @default(autoincrement())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  eventType   String                               // "link_blocked" | "member_welcomed" | "automation_fired"
  metadata    Json?
  createdAt    DateTime @default(now())

  @@index([serverId, createdAt])
  @@index([eventType, createdAt])
  @@map("bot_event_log")
}